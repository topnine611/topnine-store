APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Set real secrets only in the VPS environment. Never commit .env.
OPENAI_API_KEY=

# Local Docker Compose defaults; replace passwords before production.
POSTGRES_DB=topnine_marketing
POSTGRES_USER=topnine_app
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://topnine_app:CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD@db:5432/topnine_marketing

# Integrations will be configured in later steps.
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
